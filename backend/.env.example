# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI vision — add ONE of these (OpenAI recommended for MVP)
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
# auto | openai | gemini
AI_PROVIDER=auto

# Optional: separate text model for /api/ask parsing (defaults to OPENAI_VISION_MODEL)
# OPENAI_TEXT_MODEL=gpt-4o-mini

# Image change thresholds (0.0–1.0)
DIFF_IGNORE_BELOW=0.08
DIFF_SAVE_NO_AI_BELOW=0.18

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
